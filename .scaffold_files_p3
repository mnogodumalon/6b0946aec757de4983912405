      style.textContent = onDashboard
        ? 'a { color: #d24601 !important; font-weight: 500; cursor: default; }'
        : '';
      return true;
    };
    if (apply()) return;
    const timer = window.setInterval(() => { if (apply()) window.clearInterval(timer); }, 250);
